{{- /*
  The whole calendar as one .ics feed, generated by Hugo from the same data the
  HTML page uses. This is why the calendar feature needs zero JavaScript.

  RFC 5545 requires CRLF line endings, hence the delimit at the end. Long lines
  should strictly be folded at 75 octets; the association's event titles and
  addresses are far shorter than that, so folding is not implemented.
*/ -}}
{{- $org := hugo.Data.organization -}}
{{- $all := partial "content/all-events.html" (dict "page" .) -}}
{{- $stamp := now.UTC.Format "20060102T150405Z" -}}
{{- $host := (urls.Parse site.BaseURL).Host -}}

{{- $lines := slice
    "BEGIN:VCALENDAR"
    "VERSION:2.0"
    (printf "PRODID:-//%s//Hugo//EN" $org.legal_name)
    "CALSCALE:GREGORIAN"
    "METHOD:PUBLISH"
    (printf "X-WR-CALNAME:%s" $org.short_name)
    (printf "X-WR-CALDESC:Events and board meetings for %s" $org.legal_name)
    "X-WR-TIMEZONE:America/New_York"
-}}

{{- range $all -}}
  {{- $uid := printf "%s-%s@%s" (.start.Format "20060102T150405") (.title | urlize) $host -}}
  {{- $desc := .summary | plainify | replaceRE `\r?\n` `\n` -}}
  {{- $lines = $lines | append
      "BEGIN:VEVENT"
      (printf "UID:%s" $uid)
      (printf "DTSTAMP:%s" $stamp)
      (printf "DTSTART:%s" (.start.UTC.Format "20060102T150405Z"))
      (printf "DTEND:%s" (.end.UTC.Format "20060102T150405Z"))
      (printf "SUMMARY:%s" (.title | plainify))
  -}}
  {{- with $desc }}{{ $lines = $lines | append (printf "DESCRIPTION:%s" .) }}{{ end -}}
  {{- /* RFC 5545 gives comma, semicolon and backslash meaning inside a value,
         so they have to be escaped — an unescaped comma in an address silently
         splits the field into a list. */ -}}
  {{- $place := .location_name -}}
  {{- with .location_address }}{{ $place = printf "%s, %s" $place . }}{{ end -}}
  {{- with $place -}}
    {{- $esc := replace (replace (replace . `\` `\\`) ";" `\;`) "," `\,` -}}
    {{- $lines = $lines | append (printf "LOCATION:%s" $esc) -}}
  {{- end -}}
  {{- with .permalink }}{{ $lines = $lines | append (printf "URL:%s%s" site.BaseURL (strings.TrimPrefix "/" .)) }}{{ end -}}
  {{- if .cancelled }}{{ $lines = $lines | append "STATUS:CANCELLED" }}{{ else }}{{ $lines = $lines | append "STATUS:CONFIRMED" }}{{ end -}}
  {{- $lines = $lines | append "END:VEVENT" -}}
{{- end -}}

{{- $lines = $lines | append "END:VCALENDAR" -}}
{{ delimit $lines "\r\n" }}
